%%{init: {"flowchart": {"curve": "basis", "nodeSpacing": 30, "rankSpacing": 60, "wrappingWidth": 420}, "themeVariables": {"fontSize": "16px"}}}%%
flowchart TB
    APPS["<b>Aplikacje</b><br/>apka mobilna · panel web i TV · tablet przy boksie · panel zespołu EQUENOR · opctl"]

    COG["AWS Cognito<br/>hasła i kody<br/>(tylko przez auth)"]
    AUTH["<b>auth</b><br/>jedyny serwis autoryzacyjny<br/>logowanie, wydaje tokeny JWT"]
    CODES["<b>wyzwalacz kodów</b><br/>(Lambda, kod auth)"]
    KMS["AWS KMS<br/>klucz podpisu"]

    subgraph DOM["Serwisy: tylko sprawdzają podpis tokenu"]
        direction LR
        stables["<b>stables</b><br/>stajnie, hale,<br/>boksy, konie"]
        operations["<b>operations</b><br/>flagi, opieka,<br/>zadania"]
        schedule["<b>schedule</b><br/>zdrowie, jazdy"]
        board["<b>board</b><br/>tablica<br/>tabletu i TV"]
        billing["<b>billing</b><br/>płatności,<br/>faktury"]
        platform["<b>platform</b><br/>wydania APK,<br/>audyt"]
        files["<b>files</b><br/>pliki w S3"]
        billing ~~~ platform ~~~ files
        stables ~~~ operations ~~~ schedule ~~~ board
    end

    CRON["<b>9 cronów</b><br/>piszą wprost do bazy"]
    DB[("PostgreSQL")]
    BUS[["SNS + SQS<br/>zdarzenia"]]

    subgraph NOTE["Powiadomienia"]
        direction LR
        notifications["<b>notifications</b><br/>komu i co wysłać<br/>(adresy z auth)"]
        sms["<b>sms</b><br/>z kolejki → AWS SMS<br/>bez bazy"]
        email["<b>email</b><br/>z kolejki → AWS SES<br/>bez bazy"]
    end

    APPS -- "logowanie hasłem i kodem,<br/>odświeżanie tokenu" --> AUTH
    AUTH -- "hasło i kod<br/>(po stronie serwera)" --> COG
    APPS == "żądania z tokenem JWT" ==> DOM
    AUTH -- "podpis" --> KMS
    AUTH -. "klucz publiczny:<br/>serwisy same sprawdzają JWT" .-> DOM
    AUTH --> DB
    AUTH -- "zdarzenia" --> BUS
    DOM --> DB
    DOM -- "zdarzenia" --> BUS
    CRON -- "zapis" --> DB
    CRON -- "zdarzenia" --> BUS
    BUS --> notifications
    notifications -- "kolejka" --> sms
    notifications -- "kolejka" --> email
    COG -- "kod" --> CODES
    CODES -- "kolejka kodów" --> sms
    CODES -- "kolejka kodów" --> email

    classDef authc fill:#fde2e4,stroke:#c0392b,stroke-width:2px,color:#111
    classDef svc fill:#e3f0fb,stroke:#2f6fa7,color:#111
    classDef ntf fill:#fff4dc,stroke:#b7791f,color:#111
    classDef cli fill:#eef7e8,stroke:#4f8a3a,color:#111
    classDef ext fill:#f4f4f4,stroke:#888,color:#111
    class AUTH,CODES authc
    class stables,operations,schedule,board,billing,platform,files svc
    class notifications,sms,email ntf
    class APPS cli
    class COG,KMS,DB,BUS,CRON ext
    style DOM fill:#f7fbff,stroke:#2f6fa7
    style NOTE fill:#fffbf2,stroke:#b7791f
