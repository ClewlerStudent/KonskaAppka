{
  "openapi": "3.1.0",
  "info": {
    "title": "EQUENOR auth",
    "version": "1"
  },
  "security": [
    {
      "accessToken": []
    }
  ],
  "tags": [
    {
      "name": "auth"
    }
  ],
  "paths": {
    "/auth/v1/sign-up": {
      "post": {
        "operationId": "signUp",
        "summary": "Rejestracja konta: kod potwierdzenia na podany kontakt",
        "tags": [
          "auth"
        ],
        "security": [],
        "x-equenor-kind": "open",
        "x-equenor-open": {
          "reason": "Rejestracja: konta jeszcze nie ma",
          "rateLimit": [
            {
              "by": "ip",
              "max": 10,
              "windowSec": 3600
            },
            {
              "by": "login",
              "max": 3,
              "windowSec": 3600
            }
          ]
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/EquenorClient"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUpRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Kod wysłany; ta sama odpowiedź bez względu na to, czy konto istnieje",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodeSentResponse"
                }
              }
            }
          },
          "400": {
            "description": "validation_failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "origin_not_allowed, client_not_allowed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "weak_password",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited",
            "headers": {
              "Retry-After": {
                "description": "Sekundy do następnej próby",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Inny błąd (problem+json)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/auth/v1/sign-up/confirm": {
      "post": {
        "operationId": "confirmSignUp",
        "summary": "Potwierdzenie konta kodem (8 cyfr); bez automatycznego logowania",
