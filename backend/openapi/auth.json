            }
          }
        }
      }
    },
    "/auth/v1/login": {
      "post": {
        "operationId": "login",
        "summary": "Logowanie hasłem: token logowania i kod MFA na kanał konta",
        "tags": [
          "auth"
        ],
        "security": [],
        "x-equenor-kind": "open",
        "x-equenor-open": {
          "reason": "Logowanie: access tokenu jeszcze nie ma",
          "rateLimit": [
            {
              "by": "ip",
              "max": 30,
              "windowSec": 900
            },
            {
              "by": "login",
              "max": 10,
              "windowSec": 900
            }
          ]
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/EquenorClient"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Kod MFA wysłany",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "validation_failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "invalid_credentials",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "account_locked, origin_not_allowed, client_not_allowed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "account_not_confirmed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited",
            "headers": {
              "Retry-After": {
                "description": "Sekundy do następnej próby",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Inny błąd (problem+json)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/auth/v1/login/mfa": {
      "post": {
        "operationId": "loginMfa",
        "summary": "Krok MFA: kod (6 cyfr) z tokenem logowania w Authorization: Login <token>",
        "tags": [
          "auth"
        ],
        "security": [
          {
            "loginToken": []
          }
        ],
        "x-equenor-kind": "open",
        "x-equenor-open": {
          "reason": "Logowanie: krok MFA z tokenem logowania",
          "rateLimit": [
            {
              "by": "ip",
              "max": 30,
              "windowSec": 300
            },
            {
              "by": "loginToken",
              "max": 10,
              "windowSec": 300
            }
          ]
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/EquenorClient"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MfaRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access token; refresh token w treści (mobile, tablet) albo w ciasteczku (web)",
            "headers": {
              "Set-Cookie": {
                "description": "__Secure-eq_rt=…; Path=/auth/v1/token; HttpOnly; Secure; SameSite=Strict (tylko web)",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "validation_failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "invalid_token, invalid_code",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "account_locked, wrong_client, origin_not_allowed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited",
            "headers": {
              "Retry-After": {
                "description": "Sekundy do następnej próby",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Inny błąd (problem+json)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/auth/v1/token": {
      "post": {
        "operationId": "refreshToken",
        "summary": "Odświeżenie tokenów refresh tokenem (treść albo ciasteczko web)",
        "tags": [
          "auth"
        ],
        "security": [
          {
            "refreshCookie": []
          },
          {}
        ],
        "x-equenor-kind": "open",
        "x-equenor-open": {
          "reason": "Odświeżenie: access token wygasł, poświadczeniem jest refresh token",
          "rateLimit": [
            {
              "by": "ip",
              "max": 120,
              "windowSec": 300
            }
          ]
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/EquenorClient"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Nowe tokeny; sid, sst i auth_time bez zmian",
            "headers": {
              "Set-Cookie": {
                "description": "__Secure-eq_rt=…; Path=/auth/v1/token; HttpOnly; Secure; SameSite=Strict (tylko web)",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "validation_failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "session_revoked",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "wrong_client, origin_not_allowed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited",
            "headers": {
              "Retry-After": {
                "description": "Sekundy do następnej próby",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Inny błąd (problem+json)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/auth/v1/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Wylogowanie: czyści ciasteczko refresh tokenu (sesji w bazie nie ma)",
        "tags": [
          "auth"
        ],
        "security": [],
        "x-equenor-kind": "open",
        "x-equenor-open": {
          "reason": "Wylogowanie: działa także po wygaśnięciu access tokenu",
          "rateLimit": [
            {
              "by": "ip",
              "max": 60,
              "windowSec": 60
            }
          ]
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/EquenorClient"
          }
        ],
        "responses": {
          "204": {
            "description": "Wylogowano",
            "headers": {
              "Set-Cookie": {
                "description": "__Secure-eq_rt=; Path=/auth/v1/token; Max-Age=0",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "origin_not_allowed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited",
            "headers": {
              "Retry-After": {
                "description": "Sekundy do następnej próby",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Inny błąd (problem+json)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/auth/v1/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Profil zalogowanej osoby i widok startowy",
        "tags": [
          "auth"
        ],
        "x-equenor-kind": "external",
        "responses": {
          "200": {
            "description": "Profil",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "invalid_token, token_expired",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Inny błąd (problem+json)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "urn:equenor:problem:<code>"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "description": "Błędy walidacji, bez wartości z żądania",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ]
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "validation_failed",
          "invalid_credentials",
          "invalid_code",
          "invalid_token",
          "token_expired",
          "session_revoked",
          "origin_not_allowed",
          "client_not_allowed",
          "wrong_client",
          "account_locked",
          "not_found",
          "account_not_confirmed",
          "payload_too_large",
          "unsupported_media_type",
          "weak_password",
          "rate_limited",
          "internal_error",
          "not_ready"
        ]
      },
      "ClientId": {
        "type": "string",
        "enum": [
          "web",
          "mobile",
          "tablet"
        ]
      },
      "Locale": {
        "type": "string",
        "enum": [
          "pl",
          "uk",
          "en"
        ]
      },
      "CodeChannel": {
        "type": "string",
        "enum": [
          "sms",
          "email"
        ]
      },
      "SignUpRequest": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254,
            "description": "E-mail albo numer telefonu (9 cyfr albo E.164)"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Co najmniej 10 znaków (inaczej 422 weak_password)"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "locale": {
            "$ref": "#/components/schemas/Locale"
          },
          "clientId": {
            "$ref": "#/components/schemas/ClientId"
          }
        },
        "required": [
          "login",
          "password",
          "displayName",
          "locale",
          "clientId"
        ]
      },
      "CodeSentResponse": {
        "type": "object",
        "properties": {
          "channel": {
            "$ref": "#/components/schemas/CodeChannel"
          },
          "maskedContact": {
            "type": "string",
            "description": "Np. +48 602 *** 145 albo d•••@stajnielipowe.pl"
          }
        },
        "required": [
          "channel",
          "maskedContact"
        ]
      },
      "SignUpConfirmRequest": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254,
            "description": "E-mail albo numer telefonu (9 cyfr albo E.164)"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{8}$"
          }
        },
        "required": [
          "login",
          "code"
        ]
      },
      "SignUpResendRequest": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254,
            "description": "E-mail albo numer telefonu (9 cyfr albo E.164)"
          }
        },
        "required": [
          "login"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254,
            "description": "E-mail albo numer telefonu (9 cyfr albo E.164)"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "clientId": {
            "$ref": "#/components/schemas/ClientId"
          }
        },
        "required": [
          "login",
          "password",
          "clientId"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "loginToken": {
            "type": "string",
            "description": "Token logowania (login+jwt) do kroku MFA"
          },
          "channel": {
            "$ref": "#/components/schemas/CodeChannel"
          },
          "maskedContact": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Sekundy do wygaśnięcia tokenu logowania"
          }
        },
        "required": [
          "loginToken",
          "channel",
          "maskedContact",
          "expiresIn"
        ]
      },
      "MfaRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          }
        },
        "required": [
          "code"
        ]
      },
      "TokenRequest": {
        "type": "object",
        "properties": {
          "grantType": {
            "type": "string",
            "const": "refresh_token"
          },
          "refreshToken": {
            "description": "Mobile i tablet; bez pola: ciasteczko i nagłówek X-Equenor-Client: web",
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "grantType"
        ]
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "const": "Bearer"
          },
          "expiresIn": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "refreshToken": {
            "description": "Tylko mobile i tablet; panel web dostaje refresh token w ciasteczku",
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn"
        ]
      },
      "StartView": {
        "type": "string",
        "enum": [
          "welcome"
        ]
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "displayName": {
            "type": "string"
          },
          "locale": {
            "$ref": "#/components/schemas/Locale"
          },
          "contact": {
            "type": "object",
            "properties": {
              "phoneMasked": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "emailMasked": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "phoneMasked",
              "emailMasked"
            ]
          },
          "businesses": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "startView": {
            "description": "Nowe wartości dochodzą addytywnie; nieznana = unknown",
            "$ref": "#/components/schemas/StartView"
          }
        },
        "required": [
          "id",
          "displayName",
          "locale",
          "contact",
          "businesses",
          "startView"
        ]
      }
    },
    "parameters": {
      "EquenorClient": {
        "name": "x-equenor-client",
        "in": "header",
        "required": false,
        "description": "Wymagany od przeglądarki (z nagłówkiem Origin) i przy refresh z ciasteczka",
        "schema": {
          "type": "string",
          "enum": [
            "web"
          ]
        }
      }
    },
    "securitySchemes": {
      "accessToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "loginToken": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Login <loginToken> z POST /auth/v1/login"
      },
      "refreshCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Secure-eq_rt"
      }
    }
  }
}
