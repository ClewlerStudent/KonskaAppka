{
  "name": "equenor-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "dev:setup": "tsx scripts/dev-setup.ts",
    "dev:auth": "tsx watch --clear-screen=false --env-file=.local/dev.env src/services/auth/main.ts",
    "serve:auth": "tsx src/services/auth/main.ts",
    "dev:inbox": "tsx scripts/dev-inbox.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:auth": "exec node dist/services/auth/main.js",
    "openapi": "tsx scripts/openapi.ts",
    "openapi:check": "tsx scripts/openapi.ts --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format && npm test && npm run openapi:check"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "fastify": "5.12.7",
    "jose": "6.2.12",
    "pino": "10.4.0",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
