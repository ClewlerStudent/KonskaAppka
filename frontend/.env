# Wartości dev (bez sekretów). Nadpisania lokalne: .env.local (poza gitem).
# Pusty adres API = ten sam origin (proxy Vite /auth → backend auth na :4010).
VITE_API_BASE_URL=
VITE_WWW_URL=http://localhost:5174
VITE_PANEL_URL=http://localhost:5173
# Adres przykładowy o realnej długości (układ stopki przy 390 px); docelowy daje CONTACT_EMAIL obrazu.
VITE_CONTACT_EMAIL=kontakt@equenor.pl
